#include <iostream>
#include <string>
#include <vector>
#include <fstream>
#include <map>

using namespace std;

class ListaObecnosci {
private:
    string* nazwa;
    bool* obecny;

public:
    ListaObecnosci(string n) {
        nazwa = new string(n);
        obecny = new bool(false);
    }

    ListaObecnosci(const ListaObecnosci& other) {
        nazwa = new string(*other.nazwa);
        obecny = new bool(*other.obecny);
    }

    ListaObecnosci& operator=(const ListaObecnosci& other) {
        if (this != &other) {
            *nazwa = *other.nazwa;
            *obecny = *other.obecny;
        }
        return *this;
    }

    ~ListaObecnosci() {
        delete nazwa;
        delete obecny;
    }

    void ustawObecnosc(bool status) { *obecny = status; }
    string getNazwa() const { return *nazwa; }
    bool getObecnosc() const { return *obecny; }
};

class Przedstawialny {
public:
    virtual string przedstawSie() const = 0;
    virtual ~Przedstawialny() = 0;
};
Przedstawialny::~Przedstawialny() {}

class IEksportowalny {
public:
    virtual map<string, string> eksportuj() const = 0;
    // NOWE: eksport samej listy obecnosci jako osobna mapa
    virtual vector<map<string, string>> eksportujListeObecnosci() const = 0;
    virtual ~IEksportowalny() {}
};

class IEksporter {
public:
    virtual void wykonajEksport(const IEksportowalny* obj, string nazwaPliku) const = 0;
    virtual ~IEksporter() {}
};

// -------------------------------------------------------
// Eksporter TXT — dane podstawowe osoby
// -------------------------------------------------------
class EksporterTxt : public IEksporter {
public:
    void wykonajEksport(const IEksportowalny* obj, string nazwaPliku) const override {
        ofstream plik(nazwaPliku, ios::app);
        if (!plik) {
            cout << "Blad otwarcia pliku do eksportu TXT!\n";
            return;
        }

        map<string, string> dane = obj->eksportuj();
        map<string, string>::const_iterator it;

        plik << "[" << dane.at("Typ") << "]\n";
        for (it = dane.begin(); it != dane.end(); ++it) {
            if (it->first != "Typ") {
                plik << it->first << ": " << it->second << "\n";
            }
        }
        plik << "\n";
        plik.close();
    }
};

class EksporterCsv : public IEksporter {
public:
    void wykonajEksport(const IEksportowalny* obj, string nazwaPliku) const override {
        ofstream plik(nazwaPliku, ios::app);
        if (!plik) {
            cout << "Blad otwarcia pliku do eksportu CSV!\n";
            return;
        }

        map<string, string> dane = obj->eksportuj();
        map<string, string>::const_iterator it;

        bool pierwszy = true;
        for (it = dane.begin(); it != dane.end(); ++it) {
            if (!pierwszy) plik << ",";
            plik << it->second;
            pierwszy = false;
        }
        plik << "\n";
        plik.close();
    }
};

class EksporterListaObecnosciTxt : public IEksporter {
public:
    void wykonajEksport(const IEksportowalny* obj, string nazwaPliku) const override {
        ofstream plik(nazwaPliku, ios::app);
        if (!plik) {
            cout << "Blad otwarcia pliku do eksportu listy obecnosci TXT!\n";
            return;
        }

        map<string, string> dane = obj->eksportuj();
        plik << "[Lista obecnosci: " << dane.at("Imie") << " " << dane.at("Nazwisko") << "]\n";

        vector<map<string, string>> listy = obj->eksportujListeObecnosci();
        if (listy.empty()) {
            plik << "  Brak list obecnosci.\n";
        } else {
            // Zgodnie z tablica: for(it = dane.begin(); it != dane.end(); ++it)
            //                        plik << it->first << ": " << it->second
            for (const auto& wpis : listy) {
                map<string, string>::const_iterator it;
                for (it = wpis.begin(); it != wpis.end(); ++it) {
                    plik << it->first << ": " << it->second << "\n";
                }
                plik << "\n";
            }
        }
        plik.close();
    }
};

// -------------------------------------------------------
// NOWY: Eksporter CSV — tylko lista obecnosci
// -------------------------------------------------------
class EksporterListaObecnosciCsv : public IEksporter {
public:
    void wykonajEksport(const IEksportowalny* obj, string nazwaPliku) const override {
        ofstream plik(nazwaPliku, ios::app);
        if (!plik) {
            cout << "Blad otwarcia pliku do eksportu listy obecnosci CSV!\n";
            return;
        }

        map<string, string> dane = obj->eksportuj();
        string pelneNazwisko = dane.at("Imie") + " " + dane.at("Nazwisko");

        vector<map<string, string>> listy = obj->eksportujListeObecnosci();
        if (listy.empty()) {
            plik << pelneNazwisko << ",brak list\n";
        } else {
            for (const auto& wpis : listy) {
                plik << pelneNazwisko;
                map<string, string>::const_iterator it;
                for (it = wpis.begin(); it != wpis.end(); ++it) {
                    plik << "," << it->second;
                }
                plik << "\n";
            }
        }
        plik.close();
    }
};

class Drukarka {
public:
    static void drukuj(const Przedstawialny& obj) {
        cout << obj.przedstawSie() << endl;
    }
};

class Osoba : public Przedstawialny, public IEksportowalny {
protected:
    string imie;
    string nazwisko;
    string data_urodzenia;
    float wzrost;
    vector<ListaObecnosci*> listy;

public:
    Osoba() : wzrost(0.0f) {}

    virtual ~Osoba() {
        for (auto l : listy) delete l;
    }

    virtual void ustaw() {
        cout << "Imie: ";           cin >> imie;
        cout << "Nazwisko: ";       cin >> nazwisko;
        cout << "Data urodzenia: "; cin >> data_urodzenia;
        cout << "Wzrost: ";         cin >> wzrost;
    }

    virtual void edytuj() {
        cout << "Nowe imie: ";           cin >> imie;
        cout << "Nowe nazwisko: ";       cin >> nazwisko;
        cout << "Nowa data urodzenia: "; cin >> data_urodzenia;
        cout << "Nowy wzrost: ";         cin >> wzrost;
    }

    void wyswietl() const {
        Drukarka::drukuj(*this);
    }

    void dodajListe(const string& nazwa) {
        listy.push_back(new ListaObecnosci(nazwa));
    }

    void ustawObecnosc(const string& nazwa) {
        for (auto& l : listy) {
            if (l->getNazwa() == nazwa) {
                bool status;
                cout << "Obecny (1/0): ";
                cin >> status;
                l->ustawObecnosc(status);
                return;
            }
        }
        cout << "Nie ma takiej listy!\n";
    }

    string getNazwisko() const { return nazwisko; }
    virtual string getTyp() const = 0;

    // NOWE: implementacja eksportu listy obecnosci
    vector<map<string, string>> eksportujListeObecnosci() const override {
        vector<map<string, string>> wynik;
        for (const auto& l : listy) {
            map<string, string> wpis;
            wpis["Nazwa"] = l->getNazwa();
            wpis["Status"] = l->getObecnosc() ? "Obecny" : "Nieobecny";
            wynik.push_back(wpis);
        }
        return wynik;
    }

protected:
    string formatujListy() const {
        string wynik;
        if (listy.empty()) {
            wynik += "  Brak list obecnosci.\n";
        } else {
            for (const auto& l : listy) {
                wynik += "  Lista [" + l->getNazwa() + "]: ";
                wynik += (l->getObecnosc() ? "Obecny" : "Nieobecny");
                wynik += "\n";
            }
        }
        return wynik;
    }
};

class Student : public Osoba {
private:
    int indeks;

public:
    Student() : indeks(0) {}

    void ustaw() override {
        Osoba::ustaw();
        cout << "Indeks: ";
        cin >> indeks;
    }

    void edytuj() override {
        Osoba::edytuj();
        cout << "Nowy indeks: ";
        cin >> indeks;
    }

    string przedstawSie() const override {
        string s;
        s += "\n========== STUDENT ==========\n";
        s += "Indeks: " + to_string(indeks) + "\n";
        s += "Imie: " + imie + " | Nazwisko: " + nazwisko + "\n";
        s += "Data urodzenia: " + data_urodzenia;
        s += " | Wzrost: " + to_string(wzrost) + " cm\n";
        s += formatujListy();
        return s;
    }

    map<string, string> eksportuj() const override {
        string listyStr;
        for (const auto& l : listy) {
            listyStr += l->getNazwa() + "=" + (l->getObecnosc() ? "Obecny" : "Nieobecny") + " ";
        }
        string przygotowaneListy = listyStr.empty() ? "brak" : listyStr.substr(0, listyStr.length() - 1);

        return {
            {"Typ", "Student"},
            {"Imie", imie},
            {"Nazwisko", nazwisko},
            {"DataUrodzenia", data_urodzenia},
            {"Wzrost", to_string(wzrost)},
            {"Indeks", to_string(indeks)},
            {"Listy", przygotowaneListy}
        };
    }

    string getTyp() const override { return "Student"; }
};

