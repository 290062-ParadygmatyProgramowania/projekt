};

class Interfejs {
private:
    vector<Osoba*> osoby;

public:
    ~Interfejs() {
        for (auto o : osoby) delete o;
    }

    void uruchom() {
        int wybor;
        string nazwisko, nazwaListy;

        do {
            cout << "\n1. Dodaj studenta\n";
            cout << "2. Dodaj pracownika\n";
            cout << "3. Dodaj liste obecnosci (dla wszystkich)\n";
            cout << "4. Ustaw obecnosc\n";
            cout << "5. Wyswietl wszystkich\n";
            cout << "6. Edytuj dane\n";
            cout << "7. Usun osobe\n";
            cout << "8. Zapisz dane do pliku\n";
            cout << "9. Zapisz liste obecnosci do pliku\n"; // NOWE
            cout << "0. Wyjscie\n";
            cout << "Wybor: ";
            cin >> wybor;

            switch (wybor) {
            case 1: {
                Student* s = new Student();
                s->ustaw();
                osoby.push_back(s);
                cout << "Dodano studenta.\n";
                break;
            }
            case 2: {
                Pracownik* p = new Pracownik();
                p->ustaw();
                osoby.push_back(p);
                cout << "Dodano pracownika.\n";
                break;
            }
            case 3: {
                cout << "Podaj nazwe listy: ";
                cin >> nazwaListy;
                for (auto o : osoby) o->dodajListe(nazwaListy);
                cout << "Dodano liste \"" << nazwaListy << "\" dla wszystkich.\n";
                break;
            }
            case 4: {
                cout << "Nazwisko: "; cin >> nazwisko;
                cout << "Lista: ";    cin >> nazwaListy;
                for (auto o : osoby)
                    if (o->getNazwisko() == nazwisko) o->ustawObecnosc(nazwaListy);
                break;
            }
            case 5: {
                if (osoby.empty()) {
                    cout << "Brak osob na liscie.\n";
                } else {
                    for (auto o : osoby) o->wyswietl();
                }
                break;
            }
            case 6: {
                cout << "Nazwisko: "; cin >> nazwisko;
                for (auto o : osoby)
                    if (o->getNazwisko() == nazwisko) {
                        o->edytuj();
                        cout << "Zaktualizowano.\n";
                    }
                break;
            }
            case 7: {
                cout << "Nazwisko: "; cin >> nazwisko;
                for (int i = 0; i < (int)osoby.size(); i++) {
                    if (osoby[i]->getNazwisko() == nazwisko) {
                        delete osoby[i];
                        osoby.erase(osoby.begin() + i);
                        cout << "Usunieto.\n";
                        break;
                    }
                }
                break;
            }

            case 8: {
                if (osoby.empty()) {
                    cout << "Brak osob do zapisania.\n";
                    break;
                }

                cout << "Wybierz format pliku:\n1. Tekstowy (TXT)\n2. Arkusz (CSV)\nWybor: ";
                int formatWybor; cin >> formatWybor;

                IEksporter* eksporter = nullptr;
                if (formatWybor == 1) {
                    eksporter = new EksporterTxt();
                } else if (formatWybor == 2) {
                    eksporter = new EksporterCsv();
                } else {
                    cout << "Nieprawidlowy format!\n";
                    break;
                }

                cout << "Zapisac (1) cala liste czy (2) jedna osobe? ";
                int tryb; cin >> tryb;

                cout << "Nazwa pliku: ";
                string plik; cin >> plik;

                ofstream czyscPlik(plik, ios::trunc);
                czyscPlik.close();

                if (tryb == 1) {
                    for (auto o : osoby) eksporter->wykonajEksport(o, plik);
                    cout << "Wyeksportowano cala liste do pliku: " << plik << "\n";
                } else if (tryb == 2) {
                    cout << "Nazwisko: "; cin >> nazwisko;
                    bool znaleziono = false;
                    for (auto o : osoby) {
                        if (o->getNazwisko() == nazwisko) {
                            eksporter->wykonajEksport(o, plik);
                            znaleziono = true;
                        }
                    }
                    if (znaleziono)
                        cout << "Wyeksportowano osobe do pliku: " << plik << "\n";
                    else
                        cout << "Nie znaleziono osoby o nazwisku: " << nazwisko << "\n";
                } else {
                    cout << "Nieprawidlowy tryb.\n";
                }

                delete eksporter;
                break;
            }

            case 9: {
                if (osoby.empty()) {
                    cout << "Brak osob do zapisania.\n";
                    break;
                }

                cout << "Wybierz format pliku:\n1. Tekstowy (TXT)\n2. Arkusz (CSV)\nWybor: ";
                int formatWybor; cin >> formatWybor;

                IEksporter* eksporter = nullptr;
                if (formatWybor == 1) {
                    eksporter = new EksporterListaObecnosciTxt();
                } else if (formatWybor == 2) {
                    eksporter = new EksporterListaObecnosciCsv();
                } else {
                    cout << "Nieprawidlowy format!\n";
                    break;
                }

                cout << "Zapisac (1) cala liste czy (2) jedna osobe? ";
                int tryb; cin >> tryb;

                cout << "Nazwa pliku: ";
                string plik; cin >> plik;

                ofstream czyscPlik(plik, ios::trunc);
                czyscPlik.close();

                if (tryb == 1) {
                    for (auto o : osoby) eksporter->wykonajEksport(o, plik);
                    cout << "Wyeksportowano liste obecnosci do pliku: " << plik << "\n";
                } else if (tryb == 2) {
                    cout << "Nazwisko: "; cin >> nazwisko;
                    bool znaleziono = false;
                    for (auto o : osoby) {
                        if (o->getNazwisko() == nazwisko) {
                            eksporter->wykonajEksport(o, plik);
                            znaleziono = true;
                        }
                    }
                    if (znaleziono)
                        cout << "Wyeksportowano liste obecnosci osoby do pliku: " << plik << "\n";
                    else
                        cout << "Nie znaleziono osoby o nazwisku: " << nazwisko << "\n";
                } else {
                    cout << "Nieprawidlowy tryb.\n";
                }

                delete eksporter;
                break;
            }

            case 0:
                cout << "Do widzenia!\n";
                break;
            default:
                cout << "Nieprawidlowy wybor.\n";
            }
        } while (wybor != 0);
    }
};

int main() {
    Interfejs app;
    app.uruchom();
    return 0;
}
